# Скопируй в .env (локально) или добавь в Vercel → Settings → Environment Variables.
# ЗНАЧЕНИЯ СЮДА НЕ ПИСАТЬ — файл коммитится в git.

# Ключ OpenRouter API (https://openrouter.ai/keys — карта не нужна)
OPENROUTER_API_KEY=

# Ключ Tavily Search API (https://app.tavily.com — бесплатно 1000 запросов/мес)
# Даёт боту доступ к актуальным новостям и фактам из интернета
TAVILY_API_KEY=

# (Опционально, устарело) Ключ Groq API
# GROQ_API_KEY=

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Произвольная строка-секрет, передаётся при setWebhook (secret_token)
TELEGRAM_WEBHOOK_SECRET=

# (Опционально) Upstash Redis — постоянная память верификации/языка/истории.
# Без них всё работает, но сбрасывается при холодных стартах Vercel.
# Создать бесплатно: console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# (Опционально) Telegram user_id админа — доступ к командам /alert_*
# Узнать свой id: напиши @userinfobot
TELEGRAM_ADMIN_ID=

# (Опционально) Имя публичного канала-радара БЕЗ @ (например: radar_kazan)
# /api/radar опрашивает t.me/s/<канал> и при посте о тревоге рассылает оповещение
RADAR_CHANNEL=
