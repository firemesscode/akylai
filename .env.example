# Скопируй в .env (локально) или добавь в Vercel → Settings → Environment Variables.
# ЗНАЧЕНИЯ СЮДА НЕ ПИСАТЬ — файл коммитится в git.

# Ключ Groq API (https://console.groq.com/keys)
GROQ_API_KEY=

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Произвольная строка-секрет, передаётся при setWebhook (secret_token)
TELEGRAM_WEBHOOK_SECRET=

# (Опционально) Upstash Redis — постоянная память верификации/языка/истории.
# Без них всё работает, но сбрасывается при холодных стартах Vercel.
# Создать бесплатно: console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
